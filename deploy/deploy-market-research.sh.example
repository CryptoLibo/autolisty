#!/usr/bin/env bash
set -Eeuo pipefail

cd /home/deploy/autolisty
test "$(git branch --show-current)" = main
test -f .env.local
for key in MARKET_RESEARCH_LIVE_ENABLED MARKET_RESEARCH_FULL_RUN_ENABLED MARKET_RESEARCH_TRIAL_ENABLED; do
  test "$(grep -Fxc "$key=false" .env.local)" -eq 1
  ! grep -Fqx "$key=true" .env.local
done
test -n "${COMPANY_BACKUP_PATH:-}"
test "${COMPANY_BACKUP_PATH#/}" != "$COMPANY_BACKUP_PATH"
test -f "$COMPANY_BACKUP_PATH"
node -e 'const D=require("better-sqlite3");const d=new D(process.env.COMPANY_BACKUP_PATH,{readonly:true,fileMustExist:true});try{if(d.pragma("integrity_check",{simple:true})!=="ok")throw Error("Company backup integrity failed")}finally{d.close()}'
test -n "${AUTOMATION_DB_PATH:-}"
test "$(grep -Fxc "AUTOMATION_DB_PATH=$AUTOMATION_DB_PATH" .env.local)" -eq 1
test "${AUTOMATION_DB_PATH#/}" != "$AUTOMATION_DB_PATH"
test -f "$AUTOMATION_DB_PATH"
test -r "$AUTOMATION_DB_PATH"
node -e 'const D=require("better-sqlite3");const d=new D(process.env.AUTOMATION_DB_PATH,{readonly:true,fileMustExist:true});try{if(d.pragma("user_version",{simple:true})!==10||d.pragma("integrity_check",{simple:true})!=="ok")throw Error("Automation v10 integrity failed")}finally{d.close()}'
git fetch origin main
git merge --ff-only origin/main
npm ci
npm run build
pm2 restart autolisty --update-env
pm2 save
