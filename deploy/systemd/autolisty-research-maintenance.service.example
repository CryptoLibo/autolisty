[Unit]
Description=Autolisty Market Research retention maintenance
After=network.target

[Service]
Type=simple
User=deploy
WorkingDirectory=/home/deploy/autolisty
Environment=AUTOMATION_DB_PATH=/var/lib/autolisty/automation.sqlite
ExecStart=/usr/bin/node /home/deploy/autolisty/scripts/research-maintenance.mjs --loop
Restart=always
RestartSec=5
StandardOutput=journal
StandardError=journal
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
